{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": ["custom_components/bepacom/frontend/src/**/*.ts"]
}
